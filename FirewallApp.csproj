<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FirewallApp</RootNamespace>
    <AssemblyName>FirewallApp</AssemblyName>
    <DefaultItemExcludes>$(DefaultItemExcludes);FirewallApp.Tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="FirewallApp.Tests\**" />
    <Content Remove="FirewallApp.Tests\**" />
    <EmbeddedResource Remove="FirewallApp.Tests\**" />
    <None Remove="FirewallApp.Tests\**" />
  </ItemGroup>

</Project>
